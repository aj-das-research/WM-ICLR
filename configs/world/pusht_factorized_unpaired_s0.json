{
  "seed": 0,
  "device": "cuda",
  "cpu_threads": 4,
  "pretrained_dir": "data/pretrained/pusht",
  "action_stats": "data/upstream/pusht/action_stats.json",
  "data_root": "data/world/pusht_relative",
  "dataset_kwargs": {
    "feature_cache": "data/features/pusht_relative",
    "preload_features": true
  },
  "output_dir": "runs/world/pusht_factorized_unpaired_s0",
  "sequence_length": 8,
  "stride": 1,
  "epochs": 30,
  "batch_size": 128,
  "num_workers": 2,
  "lr": 5e-05,
  "min_lr": 1e-06,
  "weight_decay": 0.001,
  "grad_clip": 1.0,
  "bf16": true,
  "log_every": 50,
  "model": {
    "mode": "factorized_unpaired",
    "context_dim": 32,
    "context_hidden": 128,
    "history_length": 3,
    "freeze_visual": true,
    "train_predictor": true,
    "alignment_weight": 1.0,
    "dynamics_consistency_weight": 0.1,
    "observation_consistency_weight": 0.01
  }
}
