% Short aliases intended for automated paper edits.
\NewDocumentCommand{\EditAdd}{ O{Codex} +m }{\ReviewAdd[#1]{#2}}
\NewDocumentCommand{\EditDelete}{ O{Codex} +m }{\ReviewDelete[#1]{#2}}
\NewDocumentCommand{\EditReplace}{ O{Codex} +m +m }{%
