% The Color variants are low-level commands for explicit colors. The public
% edit commands accept a reviewer name and default to Codex. In final mode,
% additions remain, deletions disappear, and replacements keep only new text.
\NewDocumentCommand{\ReviewAddColor}{ O{reviewblue} +m }{%
  \iflabreview@visible
    \begingroup
      \setulcolor{#1}%
      \color{#1}\ul{#2}%
    \endgroup
  \else
    #2%
  \fi
}

\NewDocumentCommand{\ReviewAdd}{ O{Codex} +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@editcolor}%
  \ReviewAddColor[\labreview@editcolor]{#2}%
}

% Named insertion shorthand. The capitalized public command is intentional:
% lowercase \insert is a TeX primitive used internally for footnotes and
% other insertions, so redefining it would make document classes unreliable.
\NewDocumentCommand{\ReviewInsert}{ O{Codex} +m }{%
  \ReviewAdd[#1]{#2}%
}

\NewDocumentCommand{\Insert}{ O{Codex} +m }{%
  \ReviewInsert[#1]{#2}%
}

\NewDocumentCommand{\ReviewDeleteColor}{ O{reviewred} +m }{%
  \iflabreview@visible
    \begingroup
      \setstcolor{#1}%
      \color{#1}\st{#2}%
    \endgroup
  \fi
}

\NewDocumentCommand{\ReviewDelete}{ O{Codex} +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@editcolor}%
  \ReviewDeleteColor[\labreview@editcolor]{#2}%
}

\NewDocumentCommand{\ReviewReplaceColor}{ O{reviewblue} +m +m }{%
  \iflabreview@visible
    \begingroup
      \setstcolor{#1}%
      \color{#1}\st{#2}%
    \endgroup
    \,%
    \begingroup
      \setulcolor{#1}%
      \color{#1}\ul{#3}%
    \endgroup
  \else
    #3%
  \fi
}

\NewDocumentCommand{\ReviewReplace}{ O{Codex} +m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@editcolor}%
  \ReviewReplaceColor[\labreview@editcolor]{#2}{#3}%
}

% Attach a reason to a visible replacement. The note vanishes in final mode.
\NewDocumentCommand{\ReviewReplaceComment}{ O{Codex} +m +m +m }{%
