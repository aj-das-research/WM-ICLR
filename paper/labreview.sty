%% Quick start:
%%   \usepackage[draft]{labreview}  % show edits and comments
%%   \usepackage[final]{labreview}  % accept edits and hide comments
%%   \Review[Sam]{claim}{Check the evidence.}
%%   \ReviewAdd[Codex]{new text}
%%   \ReviewDelete[Codex]{old text}
%%   \ReviewReplace[Codex]{old text}{new text}
%%   \ReviewReplaceComment[Codex]{old}{new}{Reason for the change.}
%%   \ReviewMarker{rewritten sentence}  % yellow highlighter, draft only
%%   \begin{ReviewMarkerBlock}           % shade whole rewritten paragraphs
%%     ...                                % as one block, draft only
%%   \end{ReviewMarkerBlock}
%%   \ReviewProtect{\mymacro}           % keep a parameterless text macro
%%                                        % intact inside every highlight
%%
%% Reviewer names are case-insensitive. Nils is blue, Sam is brown, and
%% Codex is teal. Other names map deterministically to the built-in palette.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{labreview}[2026/09/24 v3.13 Academic review with side-aware connectors, boxes, overlays, highlighter, and wrap-safe citations]

% --------------------------------------------------------------------------
% Package mode
% --------------------------------------------------------------------------
\newif\iflabreview@visible
\newif\iflabreview@singlecolumn
\labreview@visibletrue
\labreview@singlecolumnfalse
\def\labreview@marginwidth{1.35cm}
\def\labreview@marginsep{0.12cm}
\def\labreview@marginwidthkey{marginwidth}
\def\labreview@marginsepkey{marginsep}

% Parse the two length-valued options without adding another package.
\def\labreview@parseoption#1=#2=#3\@nil{%
  \def\labreview@optionkey{#1}%
  \ifx\labreview@optionkey\labreview@marginwidthkey
    \def\labreview@marginwidth{#2}%
  \else
    \ifx\labreview@optionkey\labreview@marginsepkey
      \def\labreview@marginsep{#2}%
    \else
      \PackageWarning{labreview}{Unknown option `\CurrentOption'}%
    \fi
  \fi
}

\DeclareOption{draft}{\labreview@visibletrue}
\DeclareOption{final}{\labreview@visiblefalse}
\DeclareOption{singlecolumn}{\labreview@singlecolumntrue}
\DeclareOption*{%
  \expandafter\labreview@parseoption\CurrentOption==\@nil
}
\ExecuteOptions{draft}
\ProcessOptions\relax

% --------------------------------------------------------------------------
% Dependencies
% --------------------------------------------------------------------------
\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{soul}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,tikzmark,shapes.geometric}
\RequirePackage{marginnote}
% framed shades rewritten paragraphs as one breakable block (ReviewMarkerBlock).
\RequirePackage{framed}
% Standard marginpars only move downward, so dense review pages can push the
% last note past the page edge. marginfit lays out each column's complete note
% stack at shipout time and can move notes upward while preserving their order.
\iflabreview@visible
  \RequirePackage{marginfit}
\fi
% Keep todonotes private when labreview loads it. This lets a manuscript define
% its own \todo command after loading labreview without a name collision.
\newif\iflabreview@loadedtodonotes
\newif\iflabreview@hadtodocommand
\@ifpackageloaded{todonotes}{%
  \labreview@loadedtodonotesfalse
  \let\labreview@todo\todo
}{%
  \labreview@loadedtodonotestrue
  \@ifundefined{todo}{%
    \labreview@hadtodocommandfalse
  }{%
    \labreview@hadtodocommandtrue
    \let\labreview@savedtodo\todo
    \let\todo\@undefined
  }
  \RequirePackage{todonotes}%
  \let\labreview@todo\todo
  \iflabreview@hadtodocommand
    \let\todo\labreview@savedtodo
  \else
    \let\todo\@undefined
  \fi
}

% A compact palette that remains distinguishable when printed.
\definecolor{reviewblue}{HTML}{2563EB}
\definecolor{reviewred}{HTML}{C62828}
\definecolor{reviewgreen}{HTML}{16803C}
\definecolor{revieworange}{HTML}{C45500}
\definecolor{reviewpurple}{HTML}{6A1B9A}
\definecolor{reviewteal}{HTML}{00796B}
\definecolor{reviewgray}{HTML}{5F6368}
\definecolor{reviewpink}{HTML}{AD1457}
\definecolor{reviewindigo}{HTML}{3949AB}
\definecolor{reviewbrown}{HTML}{795548}
\definecolor{reviewcyan}{HTML}{00838F}
\definecolor{reviewolive}{HTML}{667A00}
\definecolor{reviewgold}{HTML}{9A6700}
% Full-strength highlighter yellow for rewritten text (\ReviewMarker).
\definecolor{reviewmarker}{HTML}{FFF06A}

% Reviewer colors are deterministic, case-insensitive, and independent of the
% order in which reviewers first appear. Known lab members have fixed colors.
% Every other normalized name is hashed into the fixed palette.
\ExplSyntaxOn
\clist_const:Nn \c_labreview_palette_clist
  {
    reviewblue, reviewbrown, reviewteal, reviewpurple,
    revieworange, reviewgreen, reviewindigo, reviewpink,
    reviewcyan, reviewolive, reviewgold, reviewgray
  }
\prop_new:N \g_labreview_reviewer_color_prop
\prop_gput:Nnn \g_labreview_reviewer_color_prop { nils } { reviewblue }
\prop_gput:Nnn \g_labreview_reviewer_color_prop { sam } { reviewbrown }
\prop_gput:Nnn \g_labreview_reviewer_color_prop { codex } { reviewteal }
\prop_gput:Nnn \g_labreview_reviewer_color_prop { reviewer } { reviewgray }
\tl_new:N \l_labreview_reviewer_name_tl
\int_new:N \l_labreview_reviewer_hash_int

\cs_new_protected:Npn \labreview_normalize_name:nN #1#2
  {
    \tl_set:Nx #2 { \str_lowercase:f { \tl_to_str:n {#1} } }
    \tl_trim_spaces:N #2
  }

\cs_new_protected:Npn \labreview_declare_name_color:nn #1#2
  {
    \labreview_normalize_name:nN {#1} \l_labreview_reviewer_name_tl
    \prop_gput:NVn \g_labreview_reviewer_color_prop
      \l_labreview_reviewer_name_tl {#2}
  }

\cs_new_protected:Npn \labreview_get_name_color:nN #1#2
  {
    \labreview_normalize_name:nN {#1} \l_labreview_reviewer_name_tl
    \prop_get:NVNTF \g_labreview_reviewer_color_prop
      \l_labreview_reviewer_name_tl #2
      { }
      {
        \int_zero:N \l_labreview_reviewer_hash_int
        \tl_map_inline:Nn \l_labreview_reviewer_name_tl
          {
            \int_set:Nn \l_labreview_reviewer_hash_int
              {
                \int_mod:nn
                  { 131 * \l_labreview_reviewer_hash_int + `##1 }
                  { 104729 }
              }
          }
        \tl_set:Nx #2
          {
            \clist_item:Nn \c_labreview_palette_clist
              {
                \int_mod:nn
                  { \l_labreview_reviewer_hash_int }
                  { \clist_count:N \c_labreview_palette_clist }
                + 1
              }
          }
      }
  }

\cs_new_protected:cpn { labreview@getnamecolor } #1#2
  { \labreview_get_name_color:nN {#1} #2 }
\cs_new_protected:cpn { labreview@declarenamecolor } #1#2
  { \labreview_declare_name_color:nn {#1} {#2} }
\ExplSyntaxOff

% Optional arguments throughout this package may be either a reviewer name or
% an explicit xcolor color name. This keeps older calls such as [reviewred]
% working while enabling newer calls such as [Sam] and [sam].
\newcommand{\labreview@getreviewerorcolor}[2]{%
  \edef\labreview@candidatecolor{#1}%
  \expandafter\@ifundefinedcolor\expandafter{\labreview@candidatecolor}{%
    \expandafter\labreview@getnamecolor\expandafter{%
      \labreview@candidatecolor}{#2}%
  }{%
    \edef#2{\labreview@candidatecolor}%
  }%
}

% Typeset the resolved xcolor name. This is useful in package diagnostics and
% reviewer legends.
\NewDocumentCommand{\ReviewColorName}{ m }{%
  \labreview@getnamecolor{#1}{\labreview@resolvedcolor}%
  \labreview@resolvedcolor
}

% Safe defaults for narrow conference margins. These lengths affect only the
% review copy. Change them after loading the package if your venue is wider.
\iflabreview@visible
  % Apply the narrow review margins after other packages have finished their
  % own setup. In particular, this avoids todonotes treating the intentional
  % narrow conference margin as a package-configuration error.
  \ifdim\marginparwidth<2cm
    \setlength{\marginparwidth}{2cm}%
  \fi
  \AddToHook{begindocument/end}{%
    \setlength{\marginparwidth}{\labreview@marginwidth}%
    \setlength{\marginparsep}{\labreview@marginsep}%
    % Keep dense review stacks compact while retaining a visible separation.
    \setlength{\marginparpush}{1pt}%
  }
\fi

\newcommand{\ReviewMargins}[2]{%
  \def\labreview@marginwidth{#1}%
  \def\labreview@marginsep{#2}%
  \setlength{\marginparwidth}{#1}%
  \setlength{\marginparsep}{#2}%
}

% Alternating margins are opt-in for single-column papers. Two-column papers
% always continue to use the margin beside each column.
\newif\iflabreview@alternatemargins
\iflabreview@singlecolumn
  \labreview@alternatemarginstrue
\else
  \labreview@alternatemarginsfalse
\fi
\newcounter{labreview@marginside}

\newcommand{\ReviewAlternateMargins}{%
  \labreview@alternatemarginstrue
  \setcounter{labreview@marginside}{0}%
}

\newcommand{\ReviewLeftMargins}{%
  \labreview@alternatemarginsfalse
  \reversemarginpar
}

\newcommand{\ReviewRightMargins}{%
  \labreview@alternatemarginsfalse
  \normalmarginpar
}

\newcommand{\labreview@placemarginnote}[1]{%
  \if@twocolumn
    \marginnote[{#1}]{#1}%
  \else
    \iflabreview@alternatemargins
      \stepcounter{labreview@marginside}%
      \ifodd\value{labreview@marginside}%
        \begingroup
          \reversemarginpar
          \marginnote[{#1}]{#1}%
        \endgroup
      \else
        \begingroup
          \normalmarginpar
          \marginnote[{#1}]{#1}%
        \endgroup
      \fi
    \else
      \marginnote[{#1}]{#1}%
    \fi
  \fi
}

% Same placement, but with distinct left and right renderings. marginnote uses
% the optional argument whenever the note lands in the left margin.
\newcommand{\labreview@placemarginnotesided}[2]{%
  \if@twocolumn
    \marginnote[{#1}]{#2}%
  \else
    \iflabreview@alternatemargins
      \stepcounter{labreview@marginside}%
      \ifodd\value{labreview@marginside}%
        \begingroup
          \reversemarginpar
          \marginnote[{#1}]{#2}%
        \endgroup
      \else
        \begingroup
          \normalmarginpar
          \marginnote[{#1}]{#2}%
        \endgroup
      \fi
    \else
      \marginnote[{#1}]{#2}%
    \fi
  \fi
}

% Help soul preserve common one-argument commands inside highlighted prose.
% Complicated mathematics should use \ReviewBox instead.
\AtBeginDocument{%
  \soulregister\cite7
  \soulregister\ref7
  \soulregister\pageref7
  \soulregister\emph7
  \soulregister\textbf7
  \soulregister\textit7
  \soulregister\texttt7
  \@ifundefined{citep}{}{\soulregister\citep7}%
  \@ifundefined{citet}{}{\soulregister\citet7}%
  \@ifundefined{cref}{}{\soulregister\cref7}%
  \@ifundefined{Cref}{}{\soulregister\Cref7}%
  \@ifundefined{eg}{}{\soulregister\eg7}%
  \@ifundefined{ie}{}{\soulregister\ie7}%
}

% --------------------------------------------------------------------------
% Notes and text markup
% --------------------------------------------------------------------------

% A connected note implementation for single-column alternating margins.
\newcounter{labreview@textnote}
\newcommand{\labreview@connectedtextnote}[3]{%
  \stepcounter{labreview@textnote}%
  \edef\labreview@textnoteid{\arabic{labreview@textnote}}%
  \tikzmark{labreview-text-target-\labreview@textnoteid}%
  \labreview@placemarginnote{%
    \begin{tikzpicture}[
      remember picture,
      baseline=(labreview-text-note-\labreview@textnoteid.base)
    ]
      \node[
        draw=#1,
        fill=#1!8,
        text=black,
        rounded corners=1.2pt,
        line width=0.45pt,
        inner sep=2pt,
        text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
        align=left,
        font=\tiny
      ] (labreview-text-note-\labreview@textnoteid) {%
        \textcolor{#1}{\sffamily\bfseries #2:}\space #3%
      };
      \begin{scope}[overlay]
        \draw[
          draw=white,
          line width=2.8pt,
          line cap=round,
          -{Stealth[length=2.7mm,width=2.1mm]},
          shorten >=1.0mm
        ] (labreview-text-note-\labreview@textnoteid) --
          (pic cs:labreview-text-target-\labreview@textnoteid);
        \draw[
          draw=#1,
          line width=0.85pt,
          line cap=round,
          -{Stealth[length=2.2mm,width=1.6mm]},
          shorten >=1.0mm
        ] (labreview-text-note-\labreview@textnoteid) --
          (pic cs:labreview-text-target-\labreview@textnoteid);
      \end{scope}
    \end{tikzpicture}%
  }%
}

% Side-aware connected note for highlighted single-column text. A note in the
% left margin points to the start of the highlight; a note in the right margin
% points to its end. #1 id, #2 color, #3 reviewer, #4 text, #5 start|end.
\newcommand{\labreview@sidedtextnotebox}[5]{%
  \begin{tikzpicture}[
    remember picture,
    baseline=(labreview-text-note-#1.base)
  ]
    \node[
      draw=#2,
      fill=#2!8,
      text=black,
      rounded corners=1.2pt,
      line width=0.45pt,
      inner sep=2pt,
      text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
      align=left,
      font=\tiny
    ] (labreview-text-note-#1) {%
      \textcolor{#2}{\sffamily\bfseries #3:}\space #4%
    };
    \begin{scope}[overlay]
      \draw[
        draw=white,
        line width=2.8pt,
        line cap=round,
        -{Stealth[length=2.7mm,width=2.1mm]},
        shorten >=1.0mm
      ] (labreview-text-note-#1) --
        (pic cs:labreview-text-#5-#1);
      \draw[
        draw=#2,
        line width=0.85pt,
        line cap=round,
        -{Stealth[length=2.2mm,width=1.6mm]},
        shorten >=1.0mm
      ] (labreview-text-note-#1) --
        (pic cs:labreview-text-#5-#1);
    \end{scope}
  \end{tikzpicture}%
}
\newcommand{\labreview@connectedsidedtextnote}[4]{%
  \labreview@placemarginnotesided
    {\labreview@sidedtextnotebox{#1}{#2}{#3}{#4}{start}}%
    {\labreview@sidedtextnotebox{#1}{#2}{#3}{#4}{end}}%
}

% Render one side of a two-column margin note. The left-margin variant points
% to the saved start mark, while the right-margin variant points to the saved
% end mark. marginfit selects the correct variant from the final page layout,
% after TeX has assigned the text to a physical column.
\newcounter{labreview@twocolumntextnote}
\newcommand{\labreview@twocolumnnotebox}[5]{%
  \labreview@getreviewerorcolor{#2}{\labreview@notecolor}%
  \begin{tikzpicture}[
    remember picture,
    baseline=(labreview-twocolumn-note-#1.base)
  ]
    \node[
      draw=\labreview@notecolor,
      fill=\labreview@notecolor!8,
      text=black,
      rounded corners=1.2pt,
      line width=0.45pt,
      inner sep=2pt,
      text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
      align=left,
      % Dense two-column review pages can contain many long notes below a
      % full-width float. A compact fixed size keeps the complete stack on the
      % page while the PDF remains readable when comments are inspected.
      font=\fontsize{4}{4.5}\selectfont
    ] (labreview-twocolumn-note-#1) {%
      \textcolor{\labreview@notecolor}{\sffamily\bfseries #3:}\space #4%
    };
    \begin{scope}[overlay]
      \draw[
        draw=white,
        line width=2.8pt,
        line cap=round,
        -{Stealth[length=2.7mm,width=2.1mm]},
        shorten >=1.0mm
      ] (labreview-twocolumn-note-#1) --
        (pic cs:labreview-text-#5-#1);
      \draw[
        draw=\labreview@notecolor,
        line width=0.85pt,
        line cap=round,
        opacity=0.22,
        -{Stealth[length=2.2mm,width=1.6mm]},
        shorten >=1.0mm
      ] (labreview-twocolumn-note-#1) --
        (pic cs:labreview-text-#5-#1);
    \end{scope}
  \end{tikzpicture}%
}

% True inside a visible ReviewMarkerBlock. framed drops every \marginpar in
% the block, so notes there use \marginnote instead, which works in boxes.
\newif\iflabreview@inblock
\newcommand{\labreview@connectedtwocolumnnote}[4]{%
  % Marginpar chooses the physical side during page construction and moves
  % nearby notes apart. Its optional branch is the left-margin rendering.
  \iflabreview@inblock
    \marginnote[%
      {\labreview@twocolumnnotebox{#1}{#2}{#3}{#4}{start}}%
    ]{%
      \labreview@twocolumnnotebox{#1}{#2}{#3}{#4}{end}%
    }%
  \else
    \marginpar[
      {\labreview@twocolumnnotebox{#1}{#2}{#3}{#4}{start}}%
    ]{%
      \labreview@twocolumnnotebox{#1}{#2}{#3}{#4}{end}%
    }%
  \fi
}

% A small connected margin note for normal body text.
% Usage: \ReviewNote[reviewblue]{Nils}{Please define this term.}
\NewDocumentCommand{\ReviewNote}{ O{reviewblue} m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \if@twocolumn
      \iflabreview@inblock
        % todonotes uses \marginpar, which framed drops inside the block.
        \labreview@connectedtextnote{\labreview@markcolor}{#2}{#3}%
      \else
        \labreview@todo[
          fancyline,
          color=\labreview@markcolor!8,
          bordercolor=\labreview@markcolor,
          linecolor=\labreview@markcolor,
          textcolor=black,
          size=\tiny
        ]{\raggedright\textcolor{\labreview@markcolor}{\sffamily\bfseries #2:}\space #3}%
      \fi
    \else
      \labreview@connectedtextnote{\labreview@markcolor}{#2}{#3}%
    \fi
  \fi
}

% A note without a connector. This is safer inside figures and other floats.
% Usage: \ReviewFloatNote[reviewblue]{Nils}{Check panel A.}
\NewDocumentCommand{\ReviewFloatNote}{ O{reviewblue} m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \labreview@placemarginnote{%
      \begingroup
      \setlength{\fboxsep}{2pt}%
      \setlength{\fboxrule}{0.45pt}%
      \fcolorbox{\labreview@markcolor}{\labreview@markcolor!8}{%
        \parbox{\dimexpr\marginparwidth-2\fboxsep-2\fboxrule\relax}{%
          \raggedright\tiny
          \textcolor{\labreview@markcolor}{\sffamily\bfseries #2:}\space #3%
        }%
      }%
      \endgroup
    }%
  \fi
}

% An in-column fallback for tables, minipages, and places where margin notes
% are not allowed by the document class.
\NewDocumentCommand{\ReviewInlineNote}{ O{reviewblue} m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \labreview@todo[
      inline,
      noinlinepar,
      color=\labreview@markcolor!8,
      bordercolor=\labreview@markcolor,
      textcolor=black,
      size=\tiny
    ]{\textcolor{\labreview@markcolor}{\sffamily\bfseries #2:}\space #3}%
  \fi
}

% Highlight prose with soul so it can wrap across lines. Inline mathematics
% cannot be reconstructed reliably by soul, so split it out and place a
% matching background behind each formula. Both $...$ and \(...\) work.
\ExplSyntaxOn
\seq_new:N \l_labreview_highlight_parts_seq
\tl_new:N \l_labreview_highlight_content_tl
\int_new:N \l_labreview_highlight_part_int

% Strength of the highlight colour in percent. Ordinary review highlights use
% a light 20 percent tint. \ReviewMarker sets it to 100 locally.
\tl_new:N \l_labreview_tint_tl
\tl_set:Nn \l_labreview_tint_tl { 20 }

% The colour at the current tint. At full strength the colour is used as
% given, so an xcolor expression such as yellow!40 also works.
\cs_new:Npn \__labreview_tinted:n #1
  {
    \int_compare:nNnTF { \l_labreview_tint_tl } = { 100 }
      {#1} { #1 ! \l_labreview_tint_tl }
  }

% soul draws the \hl bar 2.5ex thick, centred 0.5ex above the baseline. In a
% dense layout, such as 10pt Times on an 11pt baseline, that bar is taller
% than the baseline distance, so TeX adds \lineskip below every highlighted
% line and the page moves. Cap the thickness at \baselineskip minus
% \lineskiplimit, inside the highlight group only, but never below 2ex.
% Layouts where 2.5ex fits are unchanged.
\dim_new:N \l__labreview_hl_thickness_dim
\cs_new_protected:Npn \__labreview_hl_thickness:
  {
    \dim_set:Nn \l__labreview_hl_thickness_dim
      {
        \dim_max:nn { 2ex }
          { \dim_min:nn { 2.5ex } { \baselineskip - \lineskiplimit } }
      }
  }
\cs_new_protected:Npn \__labreview_fit_hl:
  {
    \__labreview_hl_thickness:
    \cs_if_exist:NT \SOUL@hlpreamble
      {
        \cs_set:Npx \SOUL@hlpreamble
          {
            \exp_not:N \setul { }
              { \dim_use:N \l__labreview_hl_thickness_dim }
            \exp_not:N \let \exp_not:N \SOUL@stcolor \exp_not:N \SOUL@hlcolor
            \exp_not:N \SOUL@stpreamble
          }
      }
  }

\cs_new_protected:Npn \labreview_highlight_text:nn #1#2
  {
    % Keep a part that is only a space, for example between two formulas.
    \tl_if_empty:nF {#2}
      {
        \begingroup
          \exp_args:Nne \colorlet { labreview@hltmp } { \__labreview_tinted:n {#1} } % review_round1 patch: XeTeX/tectonic soul needs a named colour
          \sethlcolor { labreview@hltmp }
          \__labreview_fit_hl:
          \hl{#2}
        \endgroup
      }
  }

% Draw the formula's background with the geometry of the soul bar, enlarged
% only when the formula itself is taller or deeper. The rule has zero width
% in the line, so the formula keeps its final-mode width and joins the
% neighbouring bars without a step or a gap.
\box_new:N \l__labreview_math_box
\dim_new:N \l__labreview_math_ht_dim
\dim_new:N \l__labreview_math_dp_dim
\cs_new_protected:Npn \labreview_highlight_math:nn #1#2
  {
    \tl_if_blank:nF {#2}
      {
        \hbox_set:Nn \l__labreview_math_box { \ensuremath {#2} }
        \__labreview_hl_thickness:
        \dim_set:Nn \l__labreview_math_ht_dim
          {
            \dim_max:nn { \box_ht:N \l__labreview_math_box }
              { 0.5ex + \l__labreview_hl_thickness_dim / 2 }
          }
        \dim_set:Nn \l__labreview_math_dp_dim
          {
            \dim_max:nn { \box_dp:N \l__labreview_math_box }
              { \l__labreview_hl_thickness_dim / 2 - 0.5ex }
          }
        \mode_leave_vertical:
        \group_begin:
          \exp_args:Ne \color { \__labreview_tinted:n {#1} }
          \rlap
            {
              \vrule
                width  \box_wd:N \l__labreview_math_box
                height \l__labreview_math_ht_dim
                depth  \l__labreview_math_dp_dim
            }
        \group_end:
        \box_use_drop:N \l__labreview_math_box
      }
  }

% soul draws a registered command such as \citep{a,b,c} as one unit at its
% natural width, although TeX can still break the citation text across lines.
% The bar then runs past the right margin. Rewrite each natbib \citep and
% \citet into one \mbox per reference before soul runs, so lines break only
% between references and every box is highlighted at its true width. Starred
% forms and optional notes are kept. natbib formats the pre-note with the
% first reference and the post-note with the last one. Every other citation
% command, such as \citeauthor{a}, \Citet{a}, or \cite{a}, is wrapped whole in
% one \mbox, because soul cannot parse it and would stop with an error.
\tl_new:N \l__labreview_cite_tl
\tl_new:N \l__labreview_cite_unit_tl
\tl_new:N \l__labreview_cite_keys_tl
\tl_new:N \l__labreview_cite_star_tl
\tl_new:N \l__labreview_cite_opts_tl
\tl_new:N \l__labreview_cite_pre_tl
\tl_new:N \l__labreview_cite_post_tl
\bool_new:N \l__labreview_cite_notes_bool
\clist_new:N \l__labreview_cite_keys_clist
\seq_new:N \l__labreview_cite_match_seq
\seq_new:N \l__labreview_cite_opts_seq
\int_new:N \l__labreview_cite_count_int
\int_new:N \l__labreview_cite_index_int
% Groups: 1 star, 2 up to two optional arguments, 3 the keys.
\regex_const:Nn \c__labreview_citep_regex
  {
    \c{citep} (\*?) ((?: \s* \[ [^\]]* \] ){0,2})
    \s* \cB\{ ([^\}]*) \cE\}
  }
\regex_const:Nn \c__labreview_citet_regex
  {
    \c{citet} (\*?) ((?: \s* \[ [^\]]* \] ){0,2})
    \s* \cB\{ ([^\}]*) \cE\}
  }
\regex_const:Nn \c__labreview_optarg_regex { \[ ([^\]]*) \] }
\regex_const:Nn \c__labreview_cite_regex
  {
    \c{cite|cite[pt]|citeal[pt]|citeauthor|citeyear|citeyearpar|citenum|Cite[pt]|Citeal[pt]|Citeauthor}
    \*? (?: \s* \[ [^\]]* \] ){0,2} \s* \cB\{ [^\}]* \cE\}
  }
\cs_generate_variant:Nn \regex_extract_once:NnNT { NV }
\cs_generate_variant:Nn \regex_extract_all:NnN { NV }

% Aliases keep the rewritten text free of the patterns searched for, so the
% rewriting loop always ends and no citation is wrapped twice. They expand at
% use time.
\cs_new:cpn { labreview@citep } { \citep }
\cs_new:cpn { labreview@citet } { \citet }
\cs_new:cpn { labreview@citealp } { \citealp }

% Read the star, the notes, and the keys of the current match. One optional
% argument is a post-note. Two are a pre-note and a post-note, as in natbib.
\cs_new_protected:Npn \__labreview_cite_parse:
  {
    \tl_set:Nx \l__labreview_cite_star_tl
      { \seq_item:Nn \l__labreview_cite_match_seq { 2 } }
    \tl_set:Nx \l__labreview_cite_opts_tl
      { \seq_item:Nn \l__labreview_cite_match_seq { 3 } }
    \tl_set:Nx \l__labreview_cite_keys_tl
      { \seq_item:Nn \l__labreview_cite_match_seq { 4 } }
    \regex_extract_all:NVN \c__labreview_optarg_regex
      \l__labreview_cite_opts_tl \l__labreview_cite_opts_seq
    \tl_clear:N \l__labreview_cite_pre_tl
    \tl_clear:N \l__labreview_cite_post_tl
    \int_case:nnF { \seq_count:N \l__labreview_cite_opts_seq }
      {
        { 0 } { \bool_set_false:N \l__labreview_cite_notes_bool }
        { 2 }
          {
            \bool_set_true:N \l__labreview_cite_notes_bool
            \tl_set:Nx \l__labreview_cite_post_tl
              { \seq_item:Nn \l__labreview_cite_opts_seq { 2 } }
          }
      }
      {
        \bool_set_true:N \l__labreview_cite_notes_bool
        \tl_set:Nx \l__labreview_cite_pre_tl
          { \seq_item:Nn \l__labreview_cite_opts_seq { 2 } }
        \tl_set:Nx \l__labreview_cite_post_tl
          { \seq_item:Nn \l__labreview_cite_opts_seq { 4 } }
      }
  }

% Build one \mbox per key of the current match. #1 is the command for a
% single key, #2 the text before the first key, #3 the separator after every
% key but the last, and #4 the text after the last key.
\cs_new_protected:Npn \__labreview_cite_units:Nnnn #1#2#3#4
  {
    \clist_set:NV \l__labreview_cite_keys_clist \l__labreview_cite_keys_tl
    \int_set:Nn \l__labreview_cite_count_int
      { \clist_count:N \l__labreview_cite_keys_clist }
    \int_zero:N \l__labreview_cite_index_int
    \tl_clear:N \l__labreview_cite_tl
    \clist_map_inline:Nn \l__labreview_cite_keys_clist
      {
        \int_incr:N \l__labreview_cite_index_int
        \int_compare:nNnF { \l__labreview_cite_index_int } = { 1 }
          { \tl_put_right:NV \l__labreview_cite_tl \c_space_tl }
        \tl_clear:N \l__labreview_cite_unit_tl
        \int_compare:nNnT { \l__labreview_cite_index_int } = { 1 }
          { \tl_put_right:Nn \l__labreview_cite_unit_tl {#2} }
        \tl_put_right:Nn \l__labreview_cite_unit_tl {#1}
        \tl_put_right:NV \l__labreview_cite_unit_tl \l__labreview_cite_star_tl
        \bool_if:NT \l__labreview_cite_notes_bool
          {
            \tl_put_right:Nn \l__labreview_cite_unit_tl { [ }
            \int_compare:nNnT { \l__labreview_cite_index_int } = { 1 }
              {
                \tl_put_right:NV \l__labreview_cite_unit_tl
                  \l__labreview_cite_pre_tl
              }
            \tl_put_right:Nn \l__labreview_cite_unit_tl { ] [ }
            \int_compare:nNnT
              { \l__labreview_cite_index_int } = { \l__labreview_cite_count_int }
              {
                \tl_put_right:NV \l__labreview_cite_unit_tl
                  \l__labreview_cite_post_tl
              }
            \tl_put_right:Nn \l__labreview_cite_unit_tl { ] }
          }
        \tl_put_right:Nn \l__labreview_cite_unit_tl { {##1} }
        \int_compare:nNnTF
          { \l__labreview_cite_index_int } = { \l__labreview_cite_count_int }
          { \tl_put_right:Nn \l__labreview_cite_unit_tl {#4} }
          { \tl_put_right:Nn \l__labreview_cite_unit_tl {#3} }
        \tl_put_right:Nx \l__labreview_cite_tl
          { \exp_not:N \mbox { \exp_not:V \l__labreview_cite_unit_tl } }
      }
  }

% Replace every match of regex #2 in #1, one at a time. #3 builds
% \l__labreview_cite_tl from the parsed match. #4 is the original command. It
% is used unchanged, inside one \mbox, when the key list is empty.
\cs_new_protected:Npn \__labreview_split_citations:NNnN #1#2#3#4
  {
    \regex_extract_once:NVNT #2 #1 \l__labreview_cite_match_seq
      {
        \__labreview_cite_parse:
        #3
        \tl_if_empty:NT \l__labreview_cite_tl
          {
            \tl_set:Nx \l__labreview_cite_tl
              {
                \exp_not:N \mbox
                  {
                    \exp_not:N #4
                    \exp_not:V \l__labreview_cite_star_tl
                    \exp_not:V \l__labreview_cite_opts_tl
                    { \exp_not:V \l__labreview_cite_keys_tl }
                  }
              }
          }
        \regex_replace_once:NnN #2 { \u{l__labreview_cite_tl} } #1
        \__labreview_split_citations:NNnN #1 #2 {#3} #4
      }
  }

\cs_new_protected:Npn \labreview_rewrite_citations:N #1
  {
    \bool_lazy_and:nnT
      { \cs_if_exist_p:N \citealp }
      { \cs_if_exist_p:c { NAT@open } }
      {
        \__labreview_split_citations:NNnN #1 \c__labreview_citep_regex
          {
            \__labreview_cite_units:Nnnn \labreview@citealp
              { \NAT@open } { \NAT@sep } { \NAT@close }
          }
          \labreview@citep
        \__labreview_split_citations:NNnN #1 \c__labreview_citet_regex
          { \__labreview_cite_units:Nnnn \labreview@citet { } { \NAT@sep } { } }
          \labreview@citet
      }
    \regex_replace_all:NnN \c__labreview_cite_regex
      { \c{mbox} \cB\{ \0 \cE\} } #1
  }

% Parameterless text macros, for example \newcommand{\dfs}{\textsc{DFS-0}},
% make soul fail with "Reconstruction failed". \ReviewProtect{\dfs\dfsone}
% lists such macros. Inside every highlight each listed token is rewritten to
% \mbox{\dfs}, which soul highlights as one protected unit.
\seq_new:N \g_labreview_protect_seq
\tl_new:N \l__labreview_protect_item_tl

\cs_new_protected:Npn \labreview_protect:n #1
  {
    \tl_map_inline:nn {#1}
      {
        \seq_if_in:NnF \g_labreview_protect_seq {##1}
          { \seq_gput_right:Nn \g_labreview_protect_seq {##1} }
      }
  }
\labreview_protect:n { \S }

\cs_new_protected:Npn \labreview_protect_macros:N #1
  {
    \seq_map_inline:Nn \g_labreview_protect_seq
      {
        \tl_set:Nn \l__labreview_protect_item_tl {##1}
        \regex_replace_all:nnN { \u{l__labreview_protect_item_tl} }
          { \c{mbox} \cB\{ \0 \cE\} } #1
      }
  }

\NewDocumentCommand { \ReviewProtect } { m } { \labreview_protect:n {#1} }

\cs_new_protected:Npn \labreview_highlight_content:nn #1#2
  {
    \tl_set:Nn \l_labreview_highlight_content_tl {#2}
    \tl_replace_all:Nnn \l_labreview_highlight_content_tl { \( } { $ }
    \tl_replace_all:Nnn \l_labreview_highlight_content_tl { \) } { $ }
    \labreview_rewrite_citations:N \l_labreview_highlight_content_tl
    \labreview_protect_macros:N \l_labreview_highlight_content_tl
    % Keep the spaces around each formula. Trimming them would join the
    % formula to the neighbouring words.
    \seq_set_split_keep_spaces:NnV \l_labreview_highlight_parts_seq { $ }
      \l_labreview_highlight_content_tl
    \int_zero:N \l_labreview_highlight_part_int
    \seq_map_inline:Nn \l_labreview_highlight_parts_seq
      {
        \int_incr:N \l_labreview_highlight_part_int
        \int_if_odd:nTF { \l_labreview_highlight_part_int }
          { \labreview_highlight_text:nn {#1} {##1} }
          { \labreview_highlight_math:nn {#1} {##1} }
      }
  }

\cs_new_protected:cpn { labreview@highlightcontent } #1#2
  { \labreview_highlight_content:nn {#1} {#2} }
\cs_new_protected:cpn { labreview@settint } #1
  { \tl_set:Nn \l_labreview_tint_tl {#1} }

% Resolve the optional colour of the highlighter commands. An xcolor
% expression such as yellow!40 is used as given. A colour name or a reviewer
% name resolves as for every other command.
\tl_new:N \l__labreview_marker_color_tl
\cs_new_protected:cpn { labreview@getmarkercolor } #1#2
  {
    \tl_set:Nx \l__labreview_marker_color_tl {#1}
    \tl_if_in:NnTF \l__labreview_marker_color_tl { ! }
      { \tl_set_eq:NN #2 \l__labreview_marker_color_tl }
      { \labreview@getreviewerorcolor {#1} {#2} }
  }
\ExplSyntaxOff

% Some manuscripts declare shorthand commands after \begin{document}. Register
% them lazily so soul can still reconstruct highlighted prose around formulas.
\newcommand{\labreview@registerlateprosemacros}{%
  \@ifundefined{eg}{}{\soulregister\eg7}%
  \@ifundefined{ie}{}{\soulregister\ie7}%
  \@ifundefined{etal}{}{\soulregister\etal7}%
  \@ifundefined{tit}{}{\soulregister\tit7}%
}

% Highlight only. Prose can wrap and inline formulas remain valid math.
\NewDocumentCommand{\ReviewHighlight}{ O{reviewblue} +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \labreview@registerlateprosemacros
    \labreview@highlightcontent{\labreview@markcolor}{#2}%
  \else
    #2%
  \fi
}

% Highlighter for rewritten text. It works like \ReviewHighlight but uses the
% colour at full strength. Draft mode only. In final mode the text is passed
% through unchanged. The optional argument is a colour name, an xcolor
% expression such as yellow!40, or a reviewer name. Use a light colour.
% Usage: \ReviewMarker{A rewritten sentence \citep{a,b}.}
\NewDocumentCommand{\ReviewMarker}{ O{reviewmarker} +m }{%
  \iflabreview@visible
    \labreview@getmarkercolor{#1}{\labreview@markcolor}%
    \begingroup
      \labreview@settint{100}%
      \labreview@registerlateprosemacros
      \labreview@highlightcontent{\labreview@markcolor}{#2}%
    \endgroup
  \else
    #2%
  \fi
}

% Shade whole rewritten paragraphs, lists, and margin notes as one block. The
% block keeps the line breaks of final mode because the frame adds no width.
% It can break across pages. In final mode it only ends the paragraph.
% framed drops floats, footnotes, and \marginpar notes inside the block.
% Review notes switch to \marginnote there, so they stay visible in single-
% and two-column documents. Keep floats and footnotes outside the block.
% The optional argument works as for \ReviewMarker.
% Usage: \begin{ReviewMarkerBlock}[reviewmarker] ... \end{ReviewMarkerBlock}
\newif\iflabreview@blockafterheading
\newif\iflabreview@blockexact
\newdimen\labreview@blockprevdepth
\newdimen\labreview@blocklastdepth
\newdimen\labreview@blockadjust
\newskip\labreview@blocktrailskip
% A macro hides the conditionals from TeX while it skips unused branches.
\def\labreview@keepnobreak{\let\if@nobreak\iftrue}
\NewDocumentEnvironment{ReviewMarkerBlock}{ O{reviewmarker} }{%
  \par
  \iflabreview@visible
    \labreview@getmarkercolor{#1}{\labreview@blockcolor}%
    % Directly after a heading the first paragraph keeps the heading's
    % indentation rule, exactly as in final mode.
    \if@nobreak
      \labreview@blockafterheadingtrue
    \else
      \labreview@blockafterheadingfalse
    \fi
    % Keep the vertical layout of final mode. The frame starts at the depth
    % of the previous line, and the box continues that line's \prevdepth, so
    % the first baseline and the \parskip above it do not move. Page tops and
    % blocks without a previous line keep the framed defaults.
    \labreview@blockexactfalse
    \ifvmode
      \ifdim\prevdepth<\z@
      \else
        \labreview@blockexacttrue
        \labreview@blockprevdepth=\prevdepth
      \fi
    \fi
    \let\labreview@savedframeheightadjust\FrameHeightAdjust
    \iflabreview@blockexact
      \global\labreview@blockadjust=\dimexpr
        \baselineskip-\labreview@blockprevdepth\relax
      \def\FrameHeightAdjust{\labreview@blockadjust}%
    \fi
    \setlength{\FrameSep}{0pt}%
    \setlength{\OuterFrameSep}{0pt}%
    \edef\FrameCommand{%
      \noexpand\fboxsep=0pt\noexpand\colorbox{\labreview@blockcolor}}%
    \labreview@inblocktrue
    \MakeFramed{%
      \advance\hsize-\width
      \FrameRestore
      \iflabreview@blockafterheading
        \labreview@keepnobreak
      \fi
      \iflabreview@blockexact
        \hbox{}%
        \prevdepth=\labreview@blockprevdepth
      \fi
    }%
  \fi
}{%
  \iflabreview@visible
    \par
    % Move trailing space, for example after a closing list, out of the box.
    % Outside it can merge with the space of a following heading or list, as
    % in final mode.
    \global\labreview@blocktrailskip=\z@skip
    \ifdim\lastskip>\z@
      \global\labreview@blocktrailskip=\lastskip
      \unskip
    \fi
    \global\labreview@blocklastdepth=\prevdepth
    % Pieces continued on a later page use the framed default again.
    \global\labreview@blockadjust=\labreview@savedframeheightadjust\relax
    \endMakeFramed
    \ifdim\labreview@blocklastdepth<\z@
    \else
      \prevdepth=\labreview@blocklastdepth
    \fi
    \ifdim\labreview@blocktrailskip>\z@
      \addvspace{\labreview@blocktrailskip}%
    \fi
  \fi
  \par
}

% Highlight plus a connected margin comment.
% Usage: \ReviewMark[reviewblue]{words to mark}{Nils}{Rewrite this claim.}
\NewDocumentCommand{\ReviewMark}{ O{reviewblue} +m m +m }{%
  \if@twocolumn
    \iflabreview@visible
      \stepcounter{labreview@twocolumntextnote}%
      \edef\labreview@twocolumntextnoteid{%
        \arabic{labreview@twocolumntextnote}}%
      \tikzmark{labreview-text-start-\labreview@twocolumntextnoteid}%
      \ReviewHighlight[#1]{#2}%
      \tikzmark{labreview-text-end-\labreview@twocolumntextnoteid}%
      \labreview@connectedtwocolumnnote
        {\labreview@twocolumntextnoteid}{#1}{#3}{#4}%
    \else
      #2%
    \fi
  \else
    \iflabreview@visible
      \stepcounter{labreview@textnote}%
      \edef\labreview@textnoteid{\arabic{labreview@textnote}}%
      \tikzmark{labreview-text-start-\labreview@textnoteid}%
      \ReviewHighlight[#1]{#2}%
      \tikzmark{labreview-text-end-\labreview@textnoteid}%
      \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
      \labreview@connectedsidedtextnote
        {\labreview@textnoteid}{\labreview@markcolor}{#3}{#4}%
    \else
      #2%
    \fi
  \fi
}

% Built-in supervisor shorthand. No declaration is required.
% Usage: \Nils{text to highlight}{margin comment}
\NewDocumentCommand{\Nils}{ +m +m }{%
  \ReviewMark[Nils]{#1}{Nils}{#2}%
}

% Generic named reviewer shorthand. No declaration is required.
% Usage: \Review[Sam]{text to highlight}{margin comment}
\NewDocumentCommand{\Review}{ O{Reviewer} +m +m }{%
  \labreview@getnamecolor{#1}{\labreview@reviewercolor}%
  \ReviewMark[\labreview@reviewercolor]{#2}{#1}{#3}%
}

