}

% Outline a short, unbreakable object. This works for a word, an equation,
% an icon, a table cell, or an entire \includegraphics command.
\NewDocumentCommand{\ReviewOutline}{ O{reviewblue} +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \tikz[baseline=(labreviewcontent.base)]{%
      \node[
        draw=\labreview@markcolor,
        line width=0.65pt,
        rounded corners=1pt,
        inner sep=1.5pt,
        outer sep=0pt
      ] (labreviewcontent) {#2};%
    }%
  \else
    #2%
  \fi
}

% Outline an object and attach a normal margin note.
\NewDocumentCommand{\ReviewBox}{ O{reviewblue} +m m +m }{%
  \ReviewOutline[#1]{#2}%
  \ReviewNote[#1]{#3}{#4}%
}

% The float-safe version for outlining a complete image or table. The outline
% is a remembered node, and the margin note draws an arrow to it: a note in the
% left margin points to the box's west edge, a note in the right margin to its
% east edge.
\newcounter{labreview@figbox}
\newcommand{\labreview@sidedboxnote}[5]{%
  \begin{tikzpicture}[
    remember picture,
    baseline=(labreview-figbox-note-#1.base)
  ]
    \node[
      draw=#2,
      fill=#2!8,
      text=black,
      rounded corners=1.2pt,
      line width=0.45pt,
      inner sep=2pt,
      text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
      align=left,
      font=\tiny
    ] (labreview-figbox-note-#1) {%
      \textcolor{#2}{\sffamily\bfseries #3:}\space #4%
    };
    \begin{scope}[overlay]
      \draw[
        draw=white,
        line width=2.8pt,
        line cap=round,
        -{Stealth[length=2.7mm,width=2.1mm]},
        shorten >=1.0mm
      ] (labreview-figbox-note-#1) --
        (labreview-figbox-#1.#5);
      \draw[
        draw=#2,
        line width=0.85pt,
        line cap=round,
        -{Stealth[length=2.2mm,width=1.6mm]},
        shorten >=1.0mm
      ] (labreview-figbox-note-#1) --
        (labreview-figbox-#1.#5);
    \end{scope}
  \end{tikzpicture}%
}
\NewDocumentCommand{\ReviewFigureBox}{ O{reviewblue} +m m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \stepcounter{labreview@figbox}%
    \edef\labreview@figboxid{\arabic{labreview@figbox}}%
    \tikz[remember picture, baseline=(labreview-figbox-\labreview@figboxid.base)]{%
      \node[
        draw=\labreview@markcolor,
        line width=0.65pt,
        rounded corners=1pt,
        inner sep=1.5pt,
        outer sep=0pt
      ] (labreview-figbox-\labreview@figboxid) {#2};%
    }%
    \labreview@placemarginnotesided
      {\labreview@sidedboxnote{\labreview@figboxid}{\labreview@markcolor}{#3}{#4}{west}}%
      {\labreview@sidedboxnote{\labreview@figboxid}{\labreview@markcolor}{#3}{#4}{east}}%
  \else
    #2%
  \fi
}

% Box the mathematics of a display equation and connect a margin note to the
% box. Use it inside the equation environment around the mathematics. Labels
% may stay inside the boxed material. A left note points to the west edge and a
% right note to the east edge, as for figures.
\newcounter{labreview@eqbox}
\newcommand{\labreview@sidedeqnote}[5]{%
  \begin{tikzpicture}[
    remember picture,
    baseline=(labreview-eqbox-note-#1.base)
  ]
    \node[
      draw=#2,
      fill=#2!8,
      text=black,
      rounded corners=1.2pt,
      line width=0.45pt,
      inner sep=2pt,
      text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
      align=left,
      font=\tiny
    ] (labreview-eqbox-note-#1) {%
      \textcolor{#2}{\sffamily\bfseries #3:}\space #4%
    };
    \begin{scope}[overlay]
      \draw[
        draw=white,
        line width=2.8pt,
        line cap=round,
        -{Stealth[length=2.7mm,width=2.1mm]},
        shorten >=1.0mm
      ] (labreview-eqbox-note-#1) --
        (labreview-eqbox-#1.#5);
      \draw[
        draw=#2,
        line width=0.85pt,
        line cap=round,
        -{Stealth[length=2.2mm,width=1.6mm]},
        shorten >=1.0mm
      ] (labreview-eqbox-note-#1) --
        (labreview-eqbox-#1.#5);
    \end{scope}
  \end{tikzpicture}%
}
\NewDocumentCommand{\ReviewEquationBox}{ O{reviewblue} +m m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \stepcounter{labreview@eqbox}%
    \edef\labreview@eqboxid{\arabic{labreview@eqbox}}%
    \tikz[remember picture, baseline=(labreview-eqbox-\labreview@eqboxid.base)]{%
      \node[
        draw=\labreview@markcolor,
        line width=0.65pt,
        rounded corners=1pt,
        inner sep=3pt,
        outer sep=0pt
      ] (labreview-eqbox-\labreview@eqboxid) {$\displaystyle #2$};%
    }%
    \labreview@placemarginnotesided
      {\labreview@sidedeqnote{\labreview@eqboxid}{\labreview@markcolor}{#3}{#4}{west}}%
      {\labreview@sidedeqnote{\labreview@eqboxid}{\labreview@markcolor}{#3}{#4}{east}}%
  \else
    #2%
  \fi
}

% Box a complete tabular and connect a margin note to it. Same behavior as
% \ReviewFigureBox. Wrap the tabular environment, or the \resizebox around it.
\NewDocumentCommand{\ReviewTableBox}{ O{reviewblue} +m m +m }{%
  \ReviewFigureBox[#1]{#2}{#3}{#4}%
}

% A page-overlay note drawn at shipout. It occupies no space in the text flow
% and therefore never moves the manuscript. Coordinates are measured from the
% upper left corner of the page. Use it for a high-level summary at the top of
% page one. Requires eso-pic.
\RequirePackage{eso-pic}
\NewDocumentCommand{\ReviewOverlayNote}{ O{Reviewer} m m m +m }{%
  \iflabreview@visible
    \AddToShipoutPictureFG*{%
      \labreview@getnamecolor{#1}{\labreview@overlaycolor}%
      \AtPageUpperLeft{%
        \put(\LenToUnit{#2},\LenToUnit{-#3}){%
          \begin{tikzpicture}[baseline=(current bounding box.north)]
            \node[
              anchor=north west,
              draw=\labreview@overlaycolor,
              fill=\labreview@overlaycolor!8,
              text=black,
              rounded corners=1.2pt,
              line width=0.45pt,
              inner sep=2pt,
              text width=\dimexpr#4-4pt\relax,
              align=left,
              font=\tiny
            ] at (0,0) {%
              \textcolor{\labreview@overlaycolor}{\sffamily\bfseries #1:}\space #5%
            };
          \end{tikzpicture}%
        }%
      }%
    }%
  \fi
}

% Circle a short object. Use the Figure variant inside a figure or algorithm
% because it attaches a float-safe note.
\NewDocumentCommand{\ReviewCircleObject}{ O{Codex} m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@markcolor}%
  \iflabreview@visible
    \tikz[baseline=(labreviewcontent.base)]{%
      \node[
        ellipse,
        draw=\labreview@markcolor,
        line width=0.9pt,
        inner xsep=3pt,
        inner ysep=1.5pt,
        outer sep=0pt
      ] (labreviewcontent) {#2};%
    }%
  \else
    #2%
  \fi
}

\NewDocumentCommand{\ReviewCircle}{ O{Codex} m +m }{%
  \ReviewCircleObject[#1]{#2}%
  \ReviewNote[#1]{#1}{#3}%
}

\NewDocumentCommand{\ReviewFigureCircle}{ O{Codex} m +m }{%
  \ReviewCircleObject[#1]{#2}%
  \ReviewFloatNote[#1]{#1}{#3}%
}

% Mark one short algorithm statement. Put this command inside \State or the
% equivalent line command supplied by the algorithm package.
\NewDocumentCommand{\ReviewAlgorithmLine}{ O{Codex} m +m }{%
  \ReviewOutline[#1]{#2}%
  \ReviewFloatNote[#1]{#1}{#3}%
}

\NewDocumentCommand{\ReviewAlgorithmCircle}{ O{Codex} m +m }{%
  \ReviewFigureCircle[#1]{#2}{#3}%
}

% --------------------------------------------------------------------------
% Figure and caption review
% --------------------------------------------------------------------------

% Place review overlays using normalized coordinates. The lower-left corner of
% the image is (0,0) and the upper-right corner is (1,1).
%
% \ReviewImage[width=\linewidth]{figure.pdf}{
%   \ReviewArea[Sam][A]{.10}{.20}{.45}{.55}
%   \ReviewCircleArea[Codex][B]{.70}{.66}{.12}{.08}
%   \ReviewPin[Nils][C]{.78}{.72}
%   \ReviewArrow[Codex]{.55}{.25}{.75}{.67}
% }
\NewDocumentCommand{\ReviewImage}{ O{} m +m }{%
  \begin{tikzpicture}
    \node[anchor=south west,inner sep=0,outer sep=0]
      (labreviewimage) at (0,0) {\includegraphics[#1]{#2}};
    \iflabreview@visible
      \begin{scope}[
        x={(labreviewimage.south east)},
        y={(labreviewimage.north west)},
        overlay
      ]
        #3
      \end{scope}
    \fi
  \end{tikzpicture}%
}

% Draw a translucent rectangular region. Coordinates are x1, y1, x2, y2.
\NewDocumentCommand{\ReviewArea}{ O{reviewred} O{} m m m m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@overlaycolor}%
  \draw[
    draw=\labreview@overlaycolor,
    fill=\labreview@overlaycolor,
    fill opacity=0.13,
    draw opacity=1,
    line width=1.15pt,
    rounded corners=1pt
  ] (#3,#4) rectangle (#5,#6);
  \ifstrempty{#2}{}{%
    \node[
      anchor=south west,
      fill=\labreview@overlaycolor,
      text=white,
      inner xsep=2.2pt,
      inner ysep=1.2pt,
      font=\sffamily\bfseries\tiny
    ] at (#3,#6) {#2};%
  }%
}

% Draw an ellipse within \ReviewImage. The four coordinates are center x,
% center y, horizontal radius, and vertical radius. All are normalized to the
% image size. The optional label is placed at the top of the ellipse.
\NewDocumentCommand{\ReviewCircleArea}{ O{Codex} O{} m m m m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@overlaycolor}%
  \draw[
    draw=\labreview@overlaycolor,
    fill=\labreview@overlaycolor,
    fill opacity=0.10,
    draw opacity=1,
    line width=1.25pt
  ] (#3,#4) ellipse [x radius=#5, y radius=#6];
  \ifstrempty{#2}{}{%
    \pgfmathsetmacro{\labreview@labely}{#4+#6}%
    \node[
      anchor=south,
      fill=\labreview@overlaycolor,
      text=white,
      inner xsep=2.2pt,
      inner ysep=1.2pt,
      font=\sffamily\bfseries\tiny
    ] at (#3,\labreview@labely) {#2};%
  }%
}

% Put a compact labeled pin on an exact point in the image.
\NewDocumentCommand{\ReviewPin}{ O{reviewpurple} O{!} m m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@overlaycolor}%
  \node[
    circle,
    fill=\labreview@overlaycolor,
    draw=white,
    line width=0.45pt,
    text=white,
    minimum size=3.5mm,
    inner sep=0.5pt,
    font=\sffamily\bfseries\tiny
  ] at (#3,#4) {#2};%
}

% Draw a curved callout arrow with a white halo. The second optional argument
% controls the bend in degrees. Use 0 for a straight arrow.
\NewDocumentCommand{\ReviewArrow}{ O{reviewblue} O{12} m m m m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@overlaycolor}%
  \draw[
    draw=white,
    line width=3.4pt,
    line cap=round,
    -{Stealth[length=3.1mm,width=2.5mm]},
    shorten <=0.8mm,
    shorten >=0.3mm
  ] (#3,#4) to[bend left=#2] (#5,#6);
  \draw[
    draw=\labreview@overlaycolor,
    line width=1.15pt,
    line cap=round,
    -{Stealth[length=2.6mm,width=1.9mm]},
    shorten <=0.8mm,
    shorten >=0.3mm
  ] (#3,#4) to[bend left=#2] (#5,#6);
  \node[
    circle,
    fill=\labreview@overlaycolor,
    draw=white,
    line width=0.55pt,
    minimum size=2.3mm,
    inner sep=0pt
  ] at (#3,#4) {};%
}

% Caption notes use TikZ marks because an ordinary marginpar is not legal
% inside a float. The connector appears after the usual two LaTeX runs.
\newcounter{labreview@captionnote}

% A caption note may be called either inside the caption paragraph or directly
% after \caption, where TeX is in vertical mode. In the latter case, a bare
% TikZ mark would start an otherwise empty line. Put all vertical-mode caption
% material in a zero-height box so neither the anchor nor the note changes the
% float height or the position of following paper content.
\newcommand{\labreview@captionoverlay}[1]{%
  \ifhmode
    #1%
  \else
    \begingroup
      % Keep the surrounding vertical list's previous-depth state unchanged.
      % This makes the zero-height box geometrically transparent to both the
      % caption above and any manuscript text below it.
      \@tempdima=\prevdepth
      \nointerlineskip
      \vbox to\z@{%
        \hsize=\linewidth
        \noindent #1\par
        \vss
      }%
      \prevdepth=\@tempdima
    \endgroup
  \fi
}

\newcommand{\labreview@margincaptionnote}[5]{%
  \labreview@placemarginnote{%
    \begin{tikzpicture}[
      remember picture,
      baseline=(labreview-caption-note-#1.base)
    ]
      \node[
        draw=#2,
        fill=#2!8,
        text=black,
        rounded corners=1.2pt,
        line width=0.45pt,
        inner sep=2pt,
        text width=\dimexpr\marginparwidth-4pt-0.9pt\relax,
        align=left,
        font=\tiny
      ] (labreview-caption-note-#1) {%
        \textcolor{#2}{\sffamily\bfseries #3:}\space #4%
      };
      \begin{scope}[overlay]
        \draw[
          draw=white,
          line width=2.8pt,
          line cap=round,
          -{Stealth[length=2.7mm,width=2.1mm]},
          shorten >=1.0mm
        ] (labreview-caption-note-#1) -- #5;
        \draw[
          draw=#2,
          line width=0.85pt,
          line cap=round,
          -{Stealth[length=2.2mm,width=1.6mm]},
          shorten >=1.0mm
        ] (labreview-caption-note-#1) -- #5;
      \end{scope}
    \end{tikzpicture}%
  }%
}

% A full-width two-column float has no usable outer margin beside its caption.
% Keep the note visible by placing a compact review box directly below it.
\newcommand{\labreview@inlinecaptionnote}[3]{%
  \par\smallskip
  \noindent
  \begingroup
    \setlength{\fboxsep}{2pt}%
    \setlength{\fboxrule}{0.45pt}%
    \fcolorbox{#1}{#1!8}{%
      \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
        \raggedright\tiny
        \textcolor{#1}{\sffamily\bfseries #2:}\space #3%
      }%
    }%
  \endgroup
}

\newcommand{\labreview@connectedcaptionnote}[5]{%
  % A marginnote is legal inside floats. The wrapper also removes the empty
  % line that a vertical-mode invocation would otherwise create.
  \labreview@captionoverlay{%
    \labreview@margincaptionnote{#1}{#2}{#3}{#4}{#5}%
  }%
}

% Add a connected float-safe margin note immediately after an ordinary
% \caption. The target is the caption's trailing edge. \ReviewedCaption below
% gives a more precise target at the center of the caption text.
\NewDocumentCommand{\ReviewCaptionNote}{ O{reviewblue} m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@captioncolor}%
  \iflabreview@visible
    \stepcounter{labreview@captionnote}%
    \edef\labreview@captionid{\arabic{labreview@captionnote}}%
    \labreview@captionoverlay{%
      \tikzmark{labreview-caption-target-\labreview@captionid}%
      \labreview@margincaptionnote
        {\labreview@captionid}{\labreview@captioncolor}{#2}{#3}
        {(pic cs:labreview-caption-target-\labreview@captionid)}%
    }%
  \fi
}

% Detailed caption helper with explicit color, short caption, full caption,
% reviewer name, and margin comment. Use it in place of \caption.
\NewDocumentCommand{\ReviewCaptionDetailed}{ O{reviewblue} m +m m +m }{%
  \labreview@getreviewerorcolor{#1}{\labreview@captioncolor}%
  \iflabreview@visible
    \stepcounter{labreview@captionnote}%
    \edef\labreview@captionid{\arabic{labreview@captionnote}}%
    \caption[#2]{%
      \tikzmark{labreview-caption-start-\labreview@captionid}%
      \ReviewHighlight[\labreview@captioncolor]{#3}%
      \tikzmark{labreview-caption-end-\labreview@captionid}%
    }%
    \labreview@connectedcaptionnote
      {\labreview@captionid}{\labreview@captioncolor}{#4}{#5}
      {($
        (pic cs:labreview-caption-start-\labreview@captionid)!
        0.5!
        (pic cs:labreview-caption-end-\labreview@captionid)
      $)}%
  \else
    \caption[#2]{#3}%
  \fi
}

% Review a complete caption and replace the ordinary \caption command. The
% first optional argument is the reviewer name. The second is a clean short
% caption for the list of figures.
% Usage: \ReviewedCaption[Sam][short caption]{full caption}{margin comment}
\NewDocumentCommand{\ReviewedCaption}{ O{Reviewer} o +m +m }{%
  \labreview@getnamecolor{#1}{\labreview@reviewercolor}%
  \IfNoValueTF{#2}{%
    \ReviewCaptionDetailed[\labreview@reviewercolor]{#3}{#3}{#1}{#4}%
  }{%
    \ReviewCaptionDetailed[\labreview@reviewercolor]{#2}{#3}{#1}{#4}%
  }%
}

% Review only part of an existing caption. This is safe in the moving caption
% argument. When the list of figures is typeset outside a float, only the plain
% reviewed text is emitted and no duplicate margin note is created.
% Usage: \caption{... \ReviewCaption[Sam]{words}{comment} ...}
\NewDocumentCommand{\ReviewCaption}{ O{Reviewer} +m +m }{%
  \iflabreview@visible
    \@ifundefined{@captype}{%
      #2%
    }{%
      \labreview@getnamecolor{#1}{\labreview@reviewercolor}%
      \ReviewHighlight[\labreview@reviewercolor]{#2}%
      \ReviewCaptionNote[\labreview@reviewercolor]{#1}{#3}%
    }%
  \else
    #2%
  \fi
}

% Built-in caption shorthand for the supervisor. It replaces \caption and
% safely connects a margin note to the highlighted caption text. An optional
% clean short caption can be supplied for the list of figures.
% Usage: \NilsCaption[short caption]{full caption}{margin comment}
\NewDocumentCommand{\NilsCaption}{ o +m +m }{%
  \IfNoValueTF{#1}{%
    \ReviewedCaption[Nils]{#2}{#3}%
  }{%
    \ReviewedCaption[Nils][#1]{#2}{#3}%
  }%
}

% Expose the todonotes summary when a manuscript needs a review checklist.
\newcommand{\ReviewList}{%
  \iflabreview@visible
    \listoftodos[Review comments]%
  \fi
}

% --------------------------------------------------------------------------
% Per-reviewer shorthand
% --------------------------------------------------------------------------

% \DeclareReviewer{nils}{Nils}{reviewblue} creates:
%   \nils{text}{comment}       highlighted text plus margin comment
%   \nilsnote{comment}          margin comment only
%   \nilsfloat{comment}         float-safe margin comment
%   \nilsinline{comment}        in-column comment
%   \nilscaption{comment}       caption margin comment
%   \nilsadd{text}              proposed addition
%   \nilsdel{text}              proposed deletion
%   \nilsrep{old}{new}          proposed replacement
%   \nilsbox{object}{comment}   outlined object plus margin comment
%   \nilsfig{object}{comment}   outlined figure plus float-safe comment
%   \nilscircle{object}{comment} circled object plus float-safe comment
\newcommand{\DeclareReviewer}[3]{%
  \labreview@declarenamecolor{#2}{#3}%
  \expandafter\newcommand\csname #1\endcsname[2]{%
    \ReviewMark[#3]{##1}{#2}{##2}}%
  \expandafter\newcommand\csname #1note\endcsname[1]{%
    \ReviewNote[#3]{#2}{##1}}%
  \expandafter\newcommand\csname #1float\endcsname[1]{%
    \ReviewFloatNote[#3]{#2}{##1}}%
  \expandafter\newcommand\csname #1inline\endcsname[1]{%
    \ReviewInlineNote[#3]{#2}{##1}}%
  \expandafter\newcommand\csname #1caption\endcsname[1]{%
    \ReviewCaptionNote[#3]{#2}{##1}}%
  \expandafter\newcommand\csname #1add\endcsname[1]{%
    \ReviewAdd[#3]{##1}}%
  \expandafter\newcommand\csname #1del\endcsname[1]{%
    \ReviewDelete[#3]{##1}}%
  \expandafter\newcommand\csname #1rep\endcsname[2]{%
    \ReviewReplace[#3]{##1}{##2}}%
  \expandafter\newcommand\csname #1box\endcsname[2]{%
    \ReviewBox[#3]{##1}{#2}{##2}}%
  \expandafter\newcommand\csname #1fig\endcsname[2]{%
    \ReviewFigureBox[#3]{##1}{#2}{##2}}%
  \expandafter\newcommand\csname #1circle\endcsname[2]{%
    \ReviewFigureCircle[#2]{##1}{##2}}%
}

