{
  "model": "ShiftWM bounded spatial mixing, internally transport/Ours-5",
  "training": "DINOv2 frozen, spatial/predictor/context/GRU/FiLM/heads trained offline. No test-time weight update illustrated.",
  "coordinates": "Shared per-channel training-normalized 16 patches \u00d7384 channels. Output denormalization omitted from diagram.",
  "inputs": {
    "images": "3 recorded support frames at stored indices0/5/10, never future frames",
    "past_actions": "2 grouped blocks a_-1:0",
    "query_actions": "causal supplied prefix a_1:h, never actions after h"
  },
  "operations": [
    {
      "id": "frozen_features",
      "input": "observed RGB",
      "output": "Z_-2,Z_-1,Z0",
      "frozen": true
    },
    {
      "id": "spatial_encoder",
      "input": "three normalized grids",
      "output": "E_-2,E_-1,E0",
      "trainable": true
    },
    {
      "id": "transition_context",
      "input": [
        "mean over16patches of encoded support",
        "past actions"
      ],
      "output": "one32-dimensional context",
      "trainable": true
    },
    {
      "id": "film",
      "input": [
        "all encoded support",
        "past-only context"
      ],
      "output": "conditioned support",
      "trainable": true
    },
    {
      "id": "prefix_gru",
      "input": "chronological normalized past and query-prefix actions",
      "output": "two original past prefix states plus query state through h",
      "trainable": true
    },
    {
      "id": "lewm",
      "input": [
        "conditioned fixed support",
        "selected causal action-prefix states"
      ],
      "output": "Hh of shape16\u00d796",
      "trainable": true
    },
    {
      "id": "key",
      "input": "E0, last observed spatial encoding BEFORE FiLM",
      "output": "K0=W_K E0",
      "trainable": true
    },
    {
      "id": "query",
      "input": "Hh",
      "output": "Qh=W_Q Hh",
      "trainable": true
    },
    {
      "id": "transport",
      "input": [
        "Qh",
        "K0"
      ],
      "output": "T=softmax_row(QK^T/sqrt96+4I),16\u00d716",
      "trainable": "operator has no independent parameters"
    },
    {
      "id": "anchor_product",
      "input": [
        "T",
        "Z0"
      ],
      "output": "T@Z0",
      "semantics": "latent feature mixtures only"
    },
    {
      "id": "gate",
      "input": "Hh",
      "output": "g=sigmoid(W_g Hh+b_g),16\u00d71",
      "trainable": true
    },
    {
      "id": "complementary_blend",
      "input": [
        "Z0",
        "T@Z0",
        "g"
      ],
      "output": "(1-g)Z0+g(T@Z0)"
    },
    {
      "id": "innovation",
      "input": "Hh",
      "output": "Delta=tanh(R(Hh)); R=LayerNorm+affine384projection",
      "trainable": true
    },
    {
      "id": "forecast",
      "input": [
        "complementary blend",
        "Delta"
      ],
      "output": "normalized predicted feature grid"
    }
  ],
  "aliases": "Hh in both panels is identical. Z0 is the last observed normalized input grid; E0 is its pre-FiLM spatial encoding.",
  "visual_only": "All feature colors, front planes, four displayed gatebars, transport weights and the three projection coordinates are illustrative. Channel depth is compressed. Feature-color mixtures use the illustrated row-stochastic matrix and complementary gates; no measured output, optical flow or RGB prediction is asserted.",
